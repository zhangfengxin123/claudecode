      },
      {
        "content": "Forecast Approach",
        "level": 3,
        "type": "heading"
      },
      {
        "children": [
          {
            "content": "The 2026 forecast employs a weighted dual-method approach:",
            "type": "text"
          }
        ],
        "type": "paragraph"
      },
      {
        "content": "Method 1: Year-over-Year YoYScaling",
        "type": "bold"
      },
      {
        "items": [
          {
            "Children": null,
            "Content": [
              {
                "Text": "Apply 13.74% YoY growth rate "
              },
              {
                "Text": "Jan 2025 to Jan 2026"
              },
              {
                "Text": " "
              },
              {
                "Text": "to 2025 monthly patterns"
              }
            ],
            "Indent": 0
          },
          {
            "Children": null,
            "Content": [
              {
                "Text": "Accounts for overall market expansion"
              }
            ],
            "Indent": 0
          },
          {
            "Children": null,
            "Content": [
              {
                "Text": "Formula: "
              },
              {
                "Code": "ForecastMonth2026 = ActualMonth2025 × 1 + YoYGrowth"
              }
            ],
            "Indent": 0
          }
        ],
        "ordered": false,
        "type": "list"
      },
      {
        "content": "Method 2: Month-over-Momentum MoM",
        "type": "bold"
      },
      {
        "items": [
          {
            "Children": null,
            "Content": [
              {
                "Text": "Apply 2025 MoM growth patterns to January 2026 baseline"
              }
            ],
            "Indent": 0
          },
          {
            "Children": null,
            "Content": [
              {
                "Text": "Captures seasonal patterns and monthly dynamics"
              }
            ],
            "Indent": 0
          },
          {
            "Children": null,
            "Content": [
              {
                "Text": "Formula: "
              },
              {
                "Code": "ForecastMonth2026 = PreviousMonth2026 × 1 + MoMRate2025"
              }
            ],
            "Indent": 0
          }
        ],
        "ordered": false,
        "type": "list"
      },
      {
        "content": "Final Weighted Forecast:",
        "type": "bold"
      },
      {
        "items": [
          {
            "Children": null,
            "Content": [
              {
                "Text": "Balances market expansion "
              },
              {
                "Text": "YoY"
              },
              {
                "Text": " "
              },
              {
                "Text": "with seasonal patterns "
              },
              {
                "Text": "MoM"
              }
            ],
            "Indent": 0
          },
          {
            "Children": null,
            "Content": [
              {
                "Text": "More conservative than pure momentum extrapolation"
